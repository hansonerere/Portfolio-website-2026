# Website reads same-origin Cloudflare APIs. No frontend API keys are needed.
# Set server-side values in Cloudflare Pages secrets or an ignored .dev.vars file.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=<sha256-of-generated-strong-admin-password>
SESSION_SECRET=<random-secret-at-least-32-characters>
R2_PUBLIC_BASE_URL=https://assets.podstudio.work
